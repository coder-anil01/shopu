```gitignore
# =========================
# Dependencies
# =========================
node_modules/
frontend/node_modules/
backend/node_modules/

# =========================
# Environment variables / Secrets
# =========================
.env
.env.*
!.env.example

frontend/.env
frontend/.env.*
!frontend/.env.example

backend/.env
backend/.env.*
!backend/.env.example

# =========================
# Build output
# =========================
dist/
build/
frontend/dist/
frontend/build/
backend/dist/
backend/build/

# =========================
# Logs
# =========================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =========================
# Cache
# =========================
.cache/
.parcel-cache/
.vite/
.eslintcache/
.npm/

# =========================
# Coverage
# =========================
coverage/

# =========================
# OS files
# =========================
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# =========================
# Editor
# =========================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# =========================
# Temporary files
# =========================
*.tmp
*.temp
*.bak

# =========================
# Backend uploads / runtime files
# =========================
backend/uploads/
backend/tmp/
backend/temp/

# =========================
# Local databases / backups
# =========================
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
